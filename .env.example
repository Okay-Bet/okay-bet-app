# SPMC API Configuration
# Main SPMC server endpoint
NEXT_PUBLIC_SPMC_URL=https://api.spmc.dev
# Alternative: Use your own SPMC instance
# NEXT_PUBLIC_SPMC_URL=http://localhost:8081

# SPMC Orchestrator (for agent deployment)
# Uses same base URL as SPMC API by default
NEXT_PUBLIC_SPMC_ORCHESTRATOR_URL=https://api.spmc.dev

# SPMC API Version (default: v1)
SPMC_API_VERSION=v1

# Legacy FastAPI endpoint (for backward compatibility)
FASTAPI_BASE_URL=http://34.10.223.180:8081

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/okaybet
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/okaybet

# PostgreSQL Configuration
POSTGRES_USER=okaybet
POSTGRES_PASSWORD=your_password_here
POSTGRES_DATABASE=okaybet
POSTGRES_HOST=localhost
POSTGRES_PRISMA_URL=postgresql://user:password@localhost:5432/okaybet
POSTGRES_URL_NON_POOLING=postgresql://user:password@localhost:5432/okaybet

# Authentication (Privy)
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Web3 Configuration
NEXT_PUBLIC_INFURA_PROJECT_ID=your_infura_project_id
INFURA_API_KEY=your_infura_api_key
NEXT_PUBLIC_BASE_MAINNET_RPC=https://base-mainnet.g.alchemy.com/v2/your_key
ALCHEMY_BASE_WSS=wss://base-mainnet.g.alchemy.com/v2/your_key

# Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Legacy API Endpoints (to be removed)
NEXT_PUBLIC_LIMITLESS_API_URL=https://api.limitless.exchange
NEXT_PUBLIC_API_BASE_URL=https://okaybet.app

# Investment Fund Contracts (Polygon Amoy Testnet)
NEXT_PUBLIC_FUND_FACTORY_ADDRESS=0x5eA0B0b61A99c1AbAB3235fd1c358dEaFe426900
NEXT_PUBLIC_USDC_ADDRESS_AMOY=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
NEXT_PUBLIC_POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_POLYGON_AMOY_CHAIN_ID=80002
GAMMA_API_URL=https://gamma-api.polymarket.com

# Agent Configuration
AGENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Third-party Services
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id

# Waitlist Configuration
# Google Sheets webhook URL for waitlist signup (optional)
# Set up a Google Apps Script webhook to collect email signups
GOOGLE_SHEETS_WEBHOOK_URL=your_google_sheets_webhook_url