generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model GroupedMarket {
  id                String    @id @default(cuid())
  limitlessMarkets  LimitlessGroupedMarket[]
  polymarketMarkets PolymarketGroupedMarket[]
  kalshiMarkets     KalshiGroupedMarket[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model LimitlessGroupedMarket {
  id            String         @id @default(cuid())
  groupedMarket GroupedMarket  @relation(fields: [groupId], references: [id])
  market        LimitlessMarket @relation(fields: [marketId], references: [id])
  groupId       String
  marketId      String
  similarity    Float?

  @@index([groupId])
  @@index([marketId])
}

model PolymarketGroupedMarket {
  id            String          @id @default(cuid())
  groupedMarket GroupedMarket   @relation(fields: [groupId], references: [id])
  market        PolymarketMarket @relation(fields: [marketId], references: [id])
  groupId       String
  marketId      String
  similarity    Float?

  @@index([groupId])
  @@index([marketId])
}

model KalshiGroupedMarket {
  id            String         @id @default(cuid())
  groupedMarket GroupedMarket  @relation(fields: [groupId], references: [id])
  market        KalshiMarket   @relation(fields: [marketId], references: [id])
  groupId       String
  marketId      String
  similarity    Float?

  @@index([groupId])
  @@index([marketId])
}


model PolymarketMarket {
  id              String    @id
  question        String
  description     String?
  endDate         DateTime?
  volume          Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isActive        Boolean   @default(true)
  lastChecked     DateTime  @default(now())
  
  groupedMarkets PolymarketGroupedMarket[]

  @@index([isActive])
  @@index([endDate])
}

model KalshiMarket {
  id              String    @id
  question        String
  description     String?
  endDate         DateTime?
  volume          Float?
  openInterest    Float?
  liquidity       Float?
  status          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isActive        Boolean   @default(true)
  lastChecked     DateTime  @default(now())
  
  groupedMarkets KalshiGroupedMarket[]

  @@index([isActive])
  @@index([endDate])
  @@index([status])
}

model LimitlessMarket {
  id              String    @id
  question        String
  description     String?
  endDate         DateTime?
  volume          Float?
  openInterest    Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isActive        Boolean   @default(true)
  lastChecked     DateTime  @default(now())
  
  groupedMarkets LimitlessGroupedMarket[]

  @@index([isActive])
  @@index([endDate])
}