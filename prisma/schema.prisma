generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model GroupedMarket {
  id                String    @id @default(cuid())
  limitlessId       String?
  polymarketId      String?
  kalshiId          String?
  similarityPoly    Float?    // Made optional with ?
  similarityKalshi  Float?    // Made optional with ?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Add foreign key relationships
  limitlessMarket   LimitlessMarket? @relation(fields: [limitlessId], references: [id])
  polymarketMarket  PolymarketMarket? @relation(fields: [polymarketId], references: [id])
  kalshiMarket      KalshiMarket? @relation(fields: [kalshiId], references: [id])

  @@index([limitlessId])
  @@index([polymarketId])
  @@index([kalshiId])
}


model PolymarketMarket {
  id              String    @id
  question        String
  description     String?
  endDate         DateTime?
  volume          Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isActive        Boolean   @default(true)
  lastChecked     DateTime  @default(now())
  
  groupedMarkets  GroupedMarket[]

  @@index([isActive])
  @@index([endDate])
}

model KalshiMarket {
  id              String    @id
  question        String
  description     String?
  endDate         DateTime?
  volume          Float?
  openInterest    Float?
  liquidity       Float?
  status          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isActive        Boolean   @default(true)
  lastChecked     DateTime  @default(now())
  
  groupedMarkets  GroupedMarket[]

  @@index([isActive])
  @@index([endDate])
  @@index([status])
}

model LimitlessMarket {
  id              String    @id
  question        String
  description     String?
  endDate         DateTime?
  volume          Float?
  openInterest    Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isActive        Boolean   @default(true)
  lastChecked     DateTime  @default(now())
  
  groupedMarkets  GroupedMarket[]

  @@index([isActive])
  @@index([endDate])
}