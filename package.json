{
  "name": "okay-bet",
  "version": "0.1.0",
  "private": true,
  "resolutions": {
    "viem": "^2.22.2"
  },
  "scripts": {
    "dev": "ts-node --project tsconfig.server.json src/server.ts",
    "predev": "npm install",
    "prebuild": "npm install",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production ts-node --project tsconfig.server.json src/server.ts",
    "prestart": "npm install",
    "lint": "next lint",
    "analyze": "ANALYZE=true npm run build",
    "setup-python": "python3 -m venv .venv && .venv/bin/pip install -r scripts/requirements.txt",
    "populate-polymarket": "PYTHONPATH=. .venv/bin/python scripts/polymarket/populate_polymarket.py",
    "populate-kalshi": "PYTHONPATH=. .venv/bin/python scripts/kalshi/populate_kalshi.py",
    "match-markets": "PYTHONPATH=. .venv/bin/python scripts/matcher/market_matcher.py",
    "populate-all-markets": "npm run populate-polymarket && npm run populate-kalshi"
  },
  "dependencies": {
    "@0x/utils": "^7.0.0",
    "@across-protocol/app-sdk": "^0.0.4",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fvictorio/newton-raphson-method": "^1.0.5",
    "@mui/icons-material": "^5.16.1",
    "@mui/material": "^5.16.1",
    "@next/bundle-analyzer": "^14.2.5",
    "@prisma/client": "^6.3.1",
    "@privy-io/react-auth": "^2.10.0",
    "@privy-io/server-auth": "^1.21.0",
    "@tanstack/react-query": "^5.51.15",
    "@types/big.js": "^6.2.2",
    "@types/lodash": "^4.17.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-slick": "^0.23.13",
    "@types/string-similarity": "^4.0.2",
    "@types/web-push": "^3.6.3",
    "@vercel/analytics": "^1.3.1",
    "autoprefixer": "^10.4.20",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "ethers": "^6.13.5",
    "events": "^3.3.0",
    "graphql": "^16.9.0",
    "graphql-request": "^7.1.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.469.0",
    "next": "14.1.0",
    "next-pwa": "^5.6.0",
    "permissionless": "^0.1.49",
    "pino-pretty": "^11.2.1",
    "postcss": "^8.4.49",
    "prisma": "^6.3.1",
    "qrcode.react": "^3.1.0",
    "react": "^18.3",
    "react-dom": "^18.3",
    "react-icons": "^5.2.1",
    "react-infinite-scroll-component": "^6.1.0",
    "react-qrcode-logo": "^3.0.0",
    "react-slick": "^0.30.2",
    "recharts": "^2.12.7",
    "sharp": "^0.33.5",
    "slick-carousel": "^1.8.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "string-similarity": "^4.0.4",
    "tailwindcss": "^3.3.0",
    "tailwindcss-bg-patterns": "^0.3.0",
